+    def _validate_authenticated_scope(
+        self,
+        user: UserIdentity,
+        action: AuthzAction,
+        tenant: Optional[str],
+        database: Optional[str],
+        collection: Optional[str],
+    ) -> Tuple[Optional[str], Optional[str]]:
+        if tenant is None and user.tenant and user.tenant != "*":
+            tenant = user.tenant
+        if database is None and user.databases and len(user.databases) == 1:
+            if user.databases[0] != "*":
+                database = user.databases[0]
+        if user.tenant and user.tenant != "*" and tenant != user.tenant:
+            raise HTTPException(status_code=403, detail="Forbidden tenant")
+        if user.databases is not None and "*" not in user.databases:
+            if database is None or database not in user.databases:
+                raise HTTPException(status_code=403, detail="Forbidden database")
+        if collection is not None and action in (
+            AuthzAction.UPDATE_COLLECTION,
+            AuthzAction.ADD,
+            AuthzAction.DELETE,
+            AuthzAction.GET,
+            AuthzAction.QUERY,
+            AuthzAction.COUNT,
+            AuthzAction.UPDATE,
+            AuthzAction.UPSERT,
+        ):
+            owner = self._api.get_collection_by_id(
+                _uuid(collection), tenant or DEFAULT_TENANT, database or DEFAULT_DATABASE
+            )
+            if owner.tenant != (tenant or DEFAULT_TENANT):
+                raise HTTPException(status_code=403, detail="Forbidden collection tenant")
+            if owner.database != (database or DEFAULT_DATABASE):
+                raise HTTPException(status_code=403, detail="Forbidden collection database")
+        return tenant, database
