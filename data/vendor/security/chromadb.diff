+def _reject_remote_code(config: Dict[str, Any]) -> None:
+    pending = [config]
+    while pending:
+        value = pending.pop()
+        if isinstance(value, dict):
+            if value.get("trust_remote_code") not in (None, False):
+                raise ValueError("Remote embedding code is prohibited in serialized configuration")
+            pending.extend(value.values())
+        elif isinstance(value, list):
+            pending.extend(value)
+
